Tunix's wayland-protocols.pc already advertises a host-absolute pkgdatadir
(the XML is consumed on the build host by wayland-scanner), and its
pkgdatadir line also prepends ${pc_sysrootdir}. With PKG_CONFIG_SYSROOT_DIR
exported -- which every *library* .pc in the sysroot needs -- the variable
comes back with the sysroot prefix twice. Let the environment state the
datadir outright; the port script knows exactly where it staged the XML.

--- a/Source/cmake/FindWaylandProtocols.cmake
+++ b/Source/cmake/FindWaylandProtocols.cmake
@@ -32,7 +32,11 @@ find_package(PkgConfig QUIET)
 pkg_check_modules(WAYLAND_PROTOCOLS wayland-protocols)

 if (WAYLAND_PROTOCOLS_FOUND)
-  pkg_get_variable(WAYLAND_PROTOCOLS_DATADIR wayland-protocols pkgdatadir)
+  if (DEFINED ENV{WAYLAND_PROTOCOLS_DATADIR})
+    set(WAYLAND_PROTOCOLS_DATADIR "$ENV{WAYLAND_PROTOCOLS_DATADIR}")
+  else ()
+    pkg_get_variable(WAYLAND_PROTOCOLS_DATADIR wayland-protocols pkgdatadir)
+  endif ()
   find_program(WAYLAND_SCANNER NAMES wayland-scanner)
   mark_as_advanced(WAYLAND_PROTOCOLS_DATADIR WAYLAND_SCANNER)
 endif ()
