woff2 1.0.2 predates the compilers that stopped transitively providing
<cstdint>; GCC 13+ no longer defines uint8_t via <string>, so output.h
fails to parse. Upstream master carries the same one-line fix.

--- a/include/woff2/output.h
+++ b/include/woff2/output.h
@@ -10,6 +10,7 @@
 #define WOFF2_WOFF2_OUT_H_

 #include <algorithm>
+#include <cstdint>
 #include <cstring>
 #include <memory>
 #include <string>
