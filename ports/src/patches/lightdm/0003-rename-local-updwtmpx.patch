Rename the local updwtmpx so it does not clash with musl's.

session-child.c defines its own static updwtmpx, with the comment "GNU provides
this but we can't rely on that". musl provides it too -- and takes a const
struct utmpx *, so the two declarations conflict and the file will not compile.

The helper is kept rather than deleted: it converts utmpx to utmp and writes
through updwtmp, which is what the original chose to do. Only the name changes.

--- a/src/session-child.c	2026-08-07 21:07:30.905220500 +0300
+++ b/src/session-child.c	2026-08-07 21:07:30.935484100 +0300
@@ -195,7 +195,7 @@
 
 /* GNU provides this but we can't rely on that so let's make our own version */
 static void
-updwtmpx (const gchar *wtmp_file, struct utmpx *ut)
+write_wtmp_record (const gchar *wtmp_file, struct utmpx *ut)
 {
     struct utmp u;
     memset (&u, 0, sizeof (u));
@@ -364,7 +364,7 @@
             ut.ut_tv.tv_sec = tv.tv_sec;
             ut.ut_tv.tv_usec = tv.tv_usec;
 
-            updwtmpx ("/var/log/btmp", &ut);
+            write_wtmp_record ("/var/log/btmp", &ut);
 
 #if HAVE_LIBAUDIT
             audit_event (AUDIT_USER_LOGIN, username, -1, remote_host_name, tty, FALSE);
@@ -709,7 +709,7 @@
             if (!pututxline (&ut))
                 g_printerr ("Failed to write utmpx: %s\n", strerror (errno));
             endutxent ();
-            updwtmpx ("/var/log/wtmp", &ut);
+            write_wtmp_record ("/var/log/wtmp", &ut);
 
 #if HAVE_LIBAUDIT
             audit_event (AUDIT_USER_LOGIN, username, uid, remote_host_name, tty, TRUE);
@@ -750,7 +750,7 @@
             if (!pututxline (&ut))
                 g_printerr ("Failed to write utmpx: %s\n", strerror (errno));
             endutxent ();
-            updwtmpx ("/var/log/wtmp", &ut);
+            write_wtmp_record ("/var/log/wtmp", &ut);
 
 #if HAVE_LIBAUDIT
             audit_event (AUDIT_USER_LOGOUT, username, uid, remote_host_name, tty, TRUE);
