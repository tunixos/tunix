Drop the glibc-only locale identification lookups.

lightdm_language_get_name and lightdm_language_get_territory ask setlocale for
LC_IDENTIFICATION and then read _NL_IDENTIFICATION_LANGUAGE / _TERRITORY out of
nl_langinfo, to get a name translated through the iso_639_3 and iso_3166
catalogs. All four of those are glibc extensions and musl has none of them.

Both functions already fall back to splitting the locale code itself, which is
what runs here: "en_US.UTF-8" gives the language "en" and the territory "US".
Nothing is lost that Tunix could have shown anyway -- the iso-codes catalogs are
not on the image either.

--- a/liblightdm-gobject/language.c	2026-08-07 21:03:43.695859500 +0300
+++ b/liblightdm-gobject/language.c	2026-08-07 21:03:57.929060200 +0300
@@ -210,19 +210,9 @@
 
     if (!priv->name)
     {
-        g_autofree gchar *locale = get_locale_name (priv->code);
-        if (locale)
-        {
-            const gchar *current = setlocale (LC_ALL, NULL);
-            setlocale (LC_IDENTIFICATION, locale);
-            setlocale (LC_MESSAGES, "");
-
-            const gchar *language_en = nl_langinfo (_NL_IDENTIFICATION_LANGUAGE);
-            if (language_en && strlen (language_en) > 0)
-                priv->name = g_strdup (dgettext ("iso_639_3", language_en));
-
-            setlocale (LC_ALL, current);
-        }
+        /* The LC_IDENTIFICATION lookup that would give a translated name is a
+           glibc extension; musl has neither the category nor the nl_langinfo
+           items. Upstream's own fallback is used instead. */
         if (!priv->name)
         {
             g_auto(GStrv) tokens = g_strsplit_set (priv->code, "_.@", 2);
@@ -250,19 +240,8 @@
 
     if (!priv->territory && strchr (priv->code, '_'))
     {
-        g_autofree gchar *locale = get_locale_name (priv->code);
-        if (locale)
-        {
-            gchar *current = setlocale (LC_ALL, NULL);
-            setlocale (LC_IDENTIFICATION, locale);
-            setlocale (LC_MESSAGES, "");
-
-            gchar *country_en = nl_langinfo (_NL_IDENTIFICATION_TERRITORY);
-            if (country_en && strlen (country_en) > 0 && g_strcmp0 (country_en, "ISO") != 0)
-                priv->territory = g_strdup (dgettext ("iso_3166", country_en));
-
-            setlocale (LC_ALL, current);
-        }
+        /* Same as above: no LC_IDENTIFICATION on musl, so the territory is the
+           one already spelled out in the locale code. */
         if (!priv->territory)
         {
             g_auto(GStrv) tokens = g_strsplit_set (priv->code, "_.@", 3);
