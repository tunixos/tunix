diff --git a/hw/xfree86/os-support/linux/lnx_init.c b/hw/xfree86/os-support/linux/lnx_init.c
index 111b3b4e4..b9243d365 100644
--- a/hw/xfree86/os-support/linux/lnx_init.c
+++ b/hw/xfree86/os-support/linux/lnx_init.c
@@ -99,6 +99,19 @@ linux_parse_vt_settings(int may_fail)
     if (vt_settings_parsed)
         return 1;
 
+    /*
+     * Tunix has no VT layer (like weston's SEATD_VTBOUND=0): with XORG_NO_VT set,
+     * skip the /dev/tty0 probe and the VT_OPENQRY/VT ioctls entirely and run the
+     * server with no controlling console. Input comes from libinput/evdev and the
+     * display from the modesetting DDX's DRM master, neither of which needs a VT.
+     */
+    if (getenv("XORG_NO_VT")) {
+        xf86Info.vtno = 0;
+        KeepTty = TRUE;
+        vt_settings_parsed = 1;
+        return 1;
+    }
+
     /*
      * setup the virtual terminal manager
      */
@@ -177,6 +190,15 @@ xf86OpenConsole(void)
     struct vt_mode VT;
     const char *vcs[] = { "/dev/vc/%d", "/dev/tty%d", NULL };
 
+    /* VT-less (Tunix): no console fd, no VT ioctls -- see linux_parse_vt_settings. */
+    if (getenv("XORG_NO_VT")) {
+        if (serverGeneration == 1) {
+            linux_parse_vt_settings(FALSE);
+            xf86Info.consoleFd = -1;
+        }
+        return;
+    }
+
     if (serverGeneration == 1) {
         linux_parse_vt_settings(FALSE);
 
@@ -302,6 +324,10 @@ xf86CloseConsole(void)
     struct vt_stat vts;
     int ret;
 
+    /* VT-less (Tunix): nothing was opened, nothing to restore. */
+    if (getenv("XORG_NO_VT") || xf86Info.consoleFd < 0)
+        return;
+
     if (xf86Info.ShareVTs) {
         close(xf86Info.consoleFd);
         return;
