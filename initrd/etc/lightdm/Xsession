#!/bin/bash
# The session wrapper. LightDM runs this as the user who logged in, with the
# session's Exec line as the argument -- so both the greeter and the desktop
# come through here.
#
# It exists to set the environment the session expects. The equivalent for a
# console login is /etc/profile plus what tunix-session exports for itself;
# LightDM's children inherit neither, because they are not started by a shell
# and their parent is a daemon.
set -u

export XKB_BINDIR=/usr/bin
export GDK_BACKEND=x11
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export XDG_CONFIG_DIRS=/etc/xdg
export XDG_DATA_DIRS=/usr/share
export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME"
chmod 0700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
cd "$HOME" 2>/dev/null || cd /

exec $@
