#!/bin/sh
# Early boot setup, run once by the rcS service before anything that needs a
# writable filesystem. Everything here is idempotent: the image ships most of
# these directories, but an initramfs boot starts from whatever the tar holds.
#
# This is also the last place that prepares the desktop as root. The session
# belongs to whoever logs in, so anything it would otherwise need root for --
# the runtime directory, the machine id, the compiled schemas -- happens here.

umask 0
mkdir -p /tmp /run/dbus /run/user/0 /var/tmp /var/log /var/lib/dbus \
    /root/.config /root/.cache /tmp/.X11-unix
chmod 1777 /tmp /var/tmp /tmp/.X11-unix
chmod 0700 /run/user/0 /root /root/.config /root/.cache
umask 022

# /run is volatile, so the user's runtime directory is created on every boot
# rather than shipped in the image.
if id -u tunix >/dev/null 2>&1; then
    mkdir -p /run/user/1000
    chown tunix:tunix /run/user/1000
    chmod 0700 /run/user/1000
    chown -R tunix:tunix /home/tunix 2>/dev/null || true
fi

# GTK apps need compiled GSettings schemas and D-Bus needs a machine id; both
# are written where only root can write.
glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
dbus-uuidgen --ensure=/var/lib/dbus/machine-id 2>/dev/null || \
    dbus-uuidgen > /etc/machine-id 2>/dev/null || true

# The CI smoke test watches the serial log for this marker; service stdout goes
# to dinit's log, so aim it at the console explicitly.
echo TUNIX_CI_BOOT_OK > /dev/console
