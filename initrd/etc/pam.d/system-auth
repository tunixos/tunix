# The shared policy every login service includes.
#
# Keeping it in one file is the point of having PAM at all: before this, login,
# su and sudo each carried their own idea of what authenticating meant.
#
# pam_unix is the only module that decides anything here. It verifies the
# crypt(3) hash in /etc/shadow -- SHA-512, which is what shadow-utils writes and
# what musl implements -- so the accounts are the same accounts as before.
auth        required    pam_unix.so
account     required    pam_unix.so
password    required    pam_unix.so sha512 shadow
session     required    pam_limits.so
session     required    pam_unix.so
