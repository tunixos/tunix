# The fallback policy, used by any service with no file of its own.
#
# Denying is the only safe default: a service that reaches here is one nobody
# wrote a policy for, and PAM has no way to know what it should be allowed to
# do. pam_warn logs the attempt so the missing file is findable.
auth        required    pam_warn.so
auth        required    pam_deny.so
account     required    pam_warn.so
account     required    pam_deny.so
password    required    pam_warn.so
password    required    pam_deny.so
session     required    pam_warn.so
session     required    pam_deny.so
