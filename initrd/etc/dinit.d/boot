# Root of the service graph. dinit (PID 1) starts "boot" and everything else
# hangs off it. waits-for rather than depends-on: a failed unit should leave
# the rest of the system up rather than take boot down with it.
type = internal
waits-for = rcS
waits-for = keymap
# The graphical login. LightDM owns the display from here on; the console
# `login` service is still defined and can be started in its place, but the two
# cannot both run -- there is one screen and one keyboard.
waits-for = lightdm
