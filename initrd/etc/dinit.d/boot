# Root of the service graph. dinit (PID 1) starts "boot" and everything else
# hangs off it. waits-for rather than depends-on: a failed unit should leave
# the rest of the system up rather than take boot down with it.
type = internal
waits-for = rcS
waits-for = keymap
# The console login prompt. The desktop is not a service any more: it belongs to
# whoever logs in, and is started by their session so that it runs as them.
waits-for = login
