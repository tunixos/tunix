# The system message bus.
#
# Tunix ran D-Bus only inside a session until now -- /bin/tunix-desktop starts
# its own dbus-daemon and nothing needed a bus that outlives one login. LightDM
# does: it publishes org.freedesktop.DisplayManager on the system bus and exits
# if it cannot own the name, so this has to be up first.
#
# It listens on /run/dbus/system_bus_socket and drops to the messagebus account,
# both from /usr/share/dbus-1/system.conf. /var/lib/dbus/machine-id is written
# by rcS, which is why this waits for it.
type = process
command = /usr/bin/dbus-daemon --system --nofork --nopidfile
depends-on = rcS
restart = true
