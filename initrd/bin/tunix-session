#!/bin/bash
# The Xfce desktop started from a console login: Xorg, then /bin/tunix-desktop.
#
# It runs as the user, not as root: everything root-only (the schema cache, the
# machine id, the writable directories under /run and /var) has moved to
# /etc/rc.d/rcS, and what is left here needs nothing more than membership of the
# video, input and audio groups.
#
# XORG_NO_VT is the SEATD_VTBOUND=0 analogue -- the modesetting DDX drives the
# DRM display and Tunix has no virtual terminal to bind to.
#
# When LightDM is running the display it starts the X server itself and calls
# /bin/tunix-desktop directly; this path is what a `login` on the console uses.
set -u

export DISPLAY=:0
export XORG_NO_VT=1
export XKB_BINDIR=/usr/bin
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}

mkdir -p "$XDG_DATA_HOME/xorg"
cd "$HOME" || cd /

Xorg :0 -config /etc/X11/xorg.conf -logfile "$XDG_DATA_HOME/xorg/Xorg.0.log" -nolisten tcp &
XORG_PID=$!

# Wait for the X server's socket before starting any client.
for i in $(seq 1 40); do
    [ -e /tmp/.X11-unix/X0 ] && break
    kill -0 "$XORG_PID" 2>/dev/null || break
    sleep 0.25
done
sleep 1

/bin/tunix-desktop &

# When X exits the session is over and the login prompt comes back.
wait "$XORG_PID"
