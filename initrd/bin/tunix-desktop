#!/bin/bash
# The Xfce desktop itself, on an X server somebody else already started.
#
# Split out of tunix-session so both ways in share one definition of what the
# desktop is: /bin/tunix-session starts Xorg and then calls this, and LightDM
# runs it directly through /etc/lightdm/Xsession with the server already up.
#
# The pieces, in order:
#   dbus-daemon   the session message bus. xfconfd (the config store) and the
#                 Xfce components activate over it.
#   xfsettingsd   applies the GTK theme, fonts, cursor and keyboard from xfconf.
#   xfwm4         the window manager, XRender compositor ON.
#   xfce4-panel   the panel / taskbar.
#   xfdesktop     the desktop background and menu.
#
# The script blocks on xfwm4: when the window manager goes, the session is over.
# That is what makes logging out return to the greeter rather than leave an
# empty screen.
set -u

export DISPLAY=${DISPLAY:-:0}
export GDK_BACKEND=x11
export XKB_BINDIR=/usr/bin
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg}
export XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/share}
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
export XDG_MENU_PREFIX=xfce-
export XDG_CURRENT_DESKTOP=XFCE
export DESKTOP_SESSION=xfce
# Use the default panel layout instead of prompting on first run -- there is
# nobody to answer the "one empty panel or the default?" dialog at login.
export XFCE_PANEL_MIGRATE_DEFAULT=1

mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME"
cd "$HOME" || cd /

dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --nofork --nopidfile &
sleep 1
xfsettingsd &
sleep 1

xfwm4 --compositor=on &
XFWM4_PID=$!
sleep 1
thunar --daemon &
xfce4-panel &
sleep 1
xfdesktop &
sleep 2

# The wallpaper: the Xfce "blue" backdrop that xfdesktop ships. The RandR output
# name is not known ahead of time, so set the backdrop on every monitor node
# xfdesktop has registered, plus the usual single-head guesses, then reload.
wp=/usr/share/backgrounds/xfce/xfce-blue.jpg
for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$'); do
    base=${prop%/last-image}
    xfconf-query -c xfce4-desktop -p "$base/image-style" -t int -s 5 2>/dev/null || \
        xfconf-query -c xfce4-desktop -p "$base/image-style" -n -t int -s 5 2>/dev/null || true
    xfconf-query -c xfce4-desktop -p "$base/last-image" -t string -s "$wp" 2>/dev/null || true
done
for base in /backdrop/screen0/monitorVirtual-1/workspace0 \
            /backdrop/screen0/monitor0/workspace0; do
    xfconf-query -c xfce4-desktop -p "$base/image-style" -n -t int -s 5 2>/dev/null || true
    xfconf-query -c xfce4-desktop -p "$base/last-image" -n -t string -s "$wp" 2>/dev/null || true
done
xfdesktop --reload 2>/dev/null || true

# The welcome screen, on a first boot only.
tunix-welcome --if-first-run &

wait "$XFWM4_PID"
