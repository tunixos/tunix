#!/bin/bash
# The Xfce desktop session on Tunix's Xorg server. dinit's "xfce" service runs
# this; it stays in the foreground (waiting on Xorg) so dinit can restart the
# whole session if the X server dies.
#
# The pieces, in order:
#   Xorg          VT-less on /dev/dri/card0 (XORG_NO_VT is the SEATD_VTBOUND=0
#                 analogue; the modesetting DDX drives the DRM display).
#   dbus-daemon   the session message bus. xfconfd (the config store) and the
#                 Xfce components activate over it; GDBus is only the client side.
#   xfsettingsd   applies the GTK theme, fonts, cursor and keyboard from xfconf.
#   xfwm4         the window manager (Xrender compositor off -- no GLX here).
#   xfce4-panel   the panel / taskbar.
#   xfdesktop     the desktop background and menu.
set -u

export HOME=/root
export DISPLAY=:0
export XORG_NO_VT=1
export XKB_BINDIR=/usr/bin
export GDK_BACKEND=x11
export XDG_RUNTIME_DIR=/run/user/0
export XDG_CONFIG_DIRS=/etc/xdg
export XDG_DATA_DIRS=/usr/share
export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.cache
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/0/bus"
# What the Xfce xinitrc would export: makes garcon build the applications menu
# (xfce- prefixed .menu) and tells apps they are in an Xfce session.
export XDG_MENU_PREFIX=xfce-
export XDG_CURRENT_DESKTOP=XFCE
export DESKTOP_SESSION=xfce
# Use the default panel layout (clock, menu, window buttons, systray) instead of
# prompting on first run -- there is nobody to answer the "one empty panel or the
# default?" dialog on a fresh boot.
export XFCE_PANEL_MIGRATE_DEFAULT=1
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"

mkdir -p /tmp/.X11-unix /var/log /run/user/0 /var/lib/dbus
chmod 1777 /tmp/.X11-unix
chmod 0700 /run/user/0

# GTK apps need compiled GSettings schemas, and D-Bus needs a machine id.
glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
dbus-uuidgen --ensure=/var/lib/dbus/machine-id 2>/dev/null || \
    dbus-uuidgen > /etc/machine-id 2>/dev/null || true

Xorg :0 -config /etc/X11/xorg.conf -logfile /var/log/Xorg.0.log -nolisten tcp &
XORG_PID=$!

# Wait for the X server's socket before starting any client.
for i in $(seq 1 40); do
    [ -e /tmp/.X11-unix/X0 ] && break
    kill -0 "$XORG_PID" 2>/dev/null || break
    sleep 0.25
done
sleep 1

# The session message bus, then the config store + settings daemon.
dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --nofork --nopidfile &
sleep 1
xfsettingsd &
sleep 1

# The desktop: window manager, then the file-manager daemon, panel and desktop.
xfwm4 --compositor=off &
sleep 1
Thunar --daemon &
xfce4-panel &
sleep 1
xfdesktop &
sleep 2

# The wallpaper. The RandR output name is not known ahead of time, so set the
# backdrop on every monitor node xfdesktop has actually registered (its
# .../last-image properties), plus the usual single-head guesses, then reload so
# xfdesktop repaints without a solid-colour fallback.
wp=/usr/share/backgrounds/tunix-wallpaper.png
for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$'); do
    base=${prop%/last-image}
    xfconf-query -c xfce4-desktop -p "$base/image-style" -t int -s 5 2>/dev/null || \
        xfconf-query -c xfce4-desktop -p "$base/image-style" -n -t int -s 5 2>/dev/null || true
    xfconf-query -c xfce4-desktop -p "$base/last-image" -t string -s "$wp" 2>/dev/null || true
done
for base in /backdrop/screen0/monitorVirtual-1/workspace0 \
            /backdrop/screen0/monitor0/workspace0; do
    xfconf-query -c xfce4-desktop -p "$base/image-style" -n -t int -s 5 2>/dev/null || true
    xfconf-query -c xfce4-desktop -p "$base/last-image" -n -t string -s "$wp" 2>/dev/null || true
done
xfdesktop --reload 2>/dev/null || true

# Keep the service in the foreground for dinit; when X exits, so does the session.
wait "$XORG_PID"
