[Desktop Entry]
Version=1.0
Type=Application
Name=Tunix Desktop
Comment=Xfce, started the way Tunix starts it
Exec=/bin/tunix-desktop
TryExec=/bin/tunix-desktop
DesktopNames=XFCE

# Deliberately not called xfce.desktop: xfce4-session installs one of those,
# with Exec=startxfce4, and the port roots are copied over the initrd. Sharing
# the name means whichever is copied last wins -- which is how the session came
# up as startxfce4 and exited 1, having tried to start an X server that LightDM
# had already started.
